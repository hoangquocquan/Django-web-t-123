# Copy to .env.phase6 (ignored) and replace every CHANGE_ME value locally.
# Never commit or print the resulting file.
PHASE6_SECRET_KEY=CHANGE_ME
PHASE6_POSTGRES_DB=phase6_portfolio
PHASE6_POSTGRES_USER=phase6_runtime
PHASE6_POSTGRES_PASSWORD=CHANGE_ME
PHASE6_REDIS_PASSWORD=CHANGE_ME
PHASE6_METRICS_BEARER_TOKEN=CHANGE_ME

# Non-secret loopback routing defaults. Alternate ports must be explicit in
# both the startup command and frontend proxy origin.
PHASE6_DJANGO_PORT=8000
PHASE6_VITE_PORT=8443
