# Copy file này thành .env khi chạy local.
# Không commit file .env thật nếu trong đó có mật khẩu hoặc secret.

MEC_ENV=development
MEC_DEBUG=true
MEC_HOST=127.0.0.1
MEC_PORT=8000
MEC_DATABASE_PATH=backend/database/mecprecision.sqlite
MEC_SESSION_TTL_SECONDS=28800
MEC_PASSWORD_SALT=doi-chuoi-salt-nay-khi-dua-len-production

# Redis là tùy chọn. Local chưa cần bật cũng chạy được.
MEC_REDIS_CACHE_ENABLED=false
MEC_REDIS_URL=redis://127.0.0.1:6379/0

# Production nên đổi domain, bật HTTPS ở Nginx/Load Balancer và dùng secret riêng.
MEC_PUBLIC_BASE_URL=https://example.com
MEC_CDN_BASE_URL=
