# Copy this file to django_backend/.env for local Django development.
# Never commit real credentials.

SECRET_KEY=replace-with-a-local-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
TIME_ZONE=Asia/Tokyo
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Browser origins allowed to call the Django API.
CORS_ALLOWED_ORIGINS=http://localhost:8443
CSRF_TRUSTED_ORIGINS=http://localhost:8443
VITE_API_BASE_URL=http://127.0.0.1:8000

# Redis is optional in development; leave empty to use local fallbacks.
REDIS_URL=
AI_REDIS_RATE_LIMIT_ENABLED=false

# Legacy Flask/SQLite compatibility is disabled by default. If an old reader is
# still required, enable it explicitly and use an existing read-only SQLite URI.
LEGACY_DATABASE_ENABLED=false
LEGACY_DATABASE_URL=

# Existing optional integrations. These are placeholders, not credentials.
METRICS_BEARER_TOKEN=
N8N_HEALTH_URL=http://localhost:5679/healthz
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Docker Compose requires non-empty local values for these variables.
POSTGRES_DB=mecprecision
POSTGRES_USER=mecprecision
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
REDIS_PASSWORD=replace-with-a-local-redis-password
N8N_ENCRYPTION_KEY=replace-with-a-local-n8n-encryption-key
N8N_WEBHOOK_SECRET=replace-with-a-local-n8n-webhook-secret
