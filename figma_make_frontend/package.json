{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check:phase6a": "oxfmt --check phase6.config.ts phase6.config.test.ts",
    "format:check:phase6d": "oxfmt --check phase6.config.ts phase6.config.test.ts src/api/phase6c.test.ts",
    "test": "node --test src/api/canonical.test.ts src/api/phase5b.test.ts src/api/phase5c.test.ts src/api/phase5d.test.ts src/api/phase5e.test.ts src/api/phase6b.test.ts src/api/phase6c.test.ts phase6.config.test.ts",
    "test:phase6a": "node --test phase6.config.test.ts",
    "test:phase6b": "node --test src/api/phase6b.test.ts",
    "test:phase6c": "node --test src/api/phase6c.test.ts",
    "test:phase6d": "node --test phase6.config.test.ts src/api/phase6c.test.ts",
    "test:phase5a": "node --test src/api/canonical.test.ts",
    "test:phase5b": "node --test src/api/phase5b.test.ts",
    "test:phase5c": "node --test src/api/phase5c.test.ts",
    "test:phase5d": "node --test src/api/phase5d.test.ts",
    "test:phase5e": "node --test src/api/phase5e.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:phase5a": "tsc --noEmit -p tsconfig.phase5a.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
