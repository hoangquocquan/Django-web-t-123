# Sao chép các tên biến này vào kho secret của môi trường chạy; không commit giá trị thật.
SECRET_KEY=
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com
POSTGRES_DB=mecprecision
POSTGRES_USER=mecprecision
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=/run/secrets/postgres-ca.pem
REDIS_PASSWORD=
REDIS_URL=
METRICS_BEARER_TOKEN=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_SECRET=
WEB_PORT=8000
OLLAMA_HOST=http://host.docker.internal:11434
AI_SALES_KNOWLEDGE_SOURCE=governed_synthetic
AI_SALES_OLLAMA_ENABLED=false
AI_AGENT_OLLAMA_PLANNER_ENABLED=false
MEDIA_ROOT=/srv/mecprecision/media
MEDIA_STORAGE_DURABLE=true
MEDIA_BACKUP_ENABLED=true
LINE_SEND_ENABLED=false
LEGACY_DATABASE_ENABLED=false
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_TOKEN_TTL_HOURS=8
AUTH_MAX_ACTIVE_TOKENS=5
UPLOAD_MAX_BYTES=10485760
ALLOWED_EXTERNAL_HOSTS=
