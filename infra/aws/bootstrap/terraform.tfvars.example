# Non-secret examples only. Copy to an ignored file and replace every placeholder.
aws_region     = "ap-northeast-1"
aws_account_id = "000000000000"
owner          = "TO_BE_APPROVED"
cost_center    = "TO_BE_APPROVED"

# Must be globally unique and approved by the operator. This example is invalid
# for real use by design; do not commit a populated backend configuration.
state_bucket_name = "replace-me-terraform-state"

oidc_provider_mode                 = "existing"
existing_github_oidc_provider_arn = "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com"

# redis_auth_token is intentionally omitted. Supply it through an approved
# sensitive input channel; never commit it or pass it on a shared command line.
