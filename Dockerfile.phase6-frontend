FROM node:22-alpine AS build

WORKDIR /frontend
RUN corepack enable
COPY figma_make_frontend/package.json figma_make_frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY figma_make_frontend/ ./
RUN pnpm build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY docker/phase6/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /frontend/dist /usr/share/nginx/html

USER 101
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/api/v1/phase6/ready/ || exit 1
